  "keyFeatures": [
    "Define and deploy AI agents with structured roles and permissions",
    "Policy-based governance to control agent behavior and scope",
    "Multi-step approval workflows for sensitive agent actions",
    "Immutable audit logs for compliance and accountability",
    "Orchestration pipelines to coordinate multi-agent workflows",
    "Event-driven triggers and real-time monitoring",
    "Webhook integrations for external system notifications",
    "SSO and role-based access control for teams"
  ],
  "publicApiSurface": [
